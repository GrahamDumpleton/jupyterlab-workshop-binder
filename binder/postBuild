#!/bin/bash
# Configure the Binder image as a general purpose launcher: it holds no
# workshops of its own, and a launch link passed through mybinder's
# urlpath parameter names the workshop, collection or catalog to open,
# so one image serves any workshop without a build of its own. Nothing
# is disabled, since the link can name any URL, and nothing is trusted
# in advance, since the content is whoever's the link points at: the
# trust dialog asks as it would anywhere else. Arriving without a launch
# link starts in the workshop browser, where a workshop can be added
# from a URL. The second block is JupyterLab's own: it turns off the
# question about fetching Jupyter news, which a fresh container would
# otherwise put in front of every visitor first.
set -euo pipefail

settings="${NB_PYTHON_PREFIX}/share/jupyter/lab/settings"

mkdir -p "$settings"

cat > "$settings/overrides.json" <<'JSON'
{
  "@jupyterlab-workshop/labextension:panel": {
    "defaultWorkshop": "",
    "browseOnStart": true
  },
  "@jupyterlab/apputils-extension:notification": {
    "fetchNews": "false"
  }
}
JSON

# The checkout is copied into the home directory, which is the JupyterLab
# root, so remove this repository's own files to leave the visitor a
# clean file browser holding only the workshops they open. The script
# runs from the checkout, and removing it while it runs is safe, since
# bash keeps the open file.
rm -rf README.md binder
